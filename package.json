{
  "name": "argentina-earthquakes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:data": "node tools/prepare-inpres.mjs",
    "predev": "npm run prepare:data",
    "dev": "next dev",
    "prebuild": "npm run prepare:data",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.mjs",
    "terrain:validate": "python tools/terrain/validate_gebco.py",
    "cartography:validate": "python tools/cartography/validate_cartography.py",
    "slab2:validate": "python tools/slab2/validate_slab2.py",
    "data:validate": "npm run terrain:validate && npm run cartography:validate && npm run slab2:validate"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "geographiclib-geodesic": "^2.2.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "typescript": "6.0.3"
  }
}
